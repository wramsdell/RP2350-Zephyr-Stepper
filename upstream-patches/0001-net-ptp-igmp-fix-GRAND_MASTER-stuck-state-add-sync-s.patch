+++ b/subsys/net/lib/ptp/state_machine.c
@@ -139,6 +139,31 @@ enum ptp_port_state ptp_state_machine(enum ptp_port_state state,
 			break;
 		}
 		break;
+	case PTP_PS_GRAND_MASTER:
