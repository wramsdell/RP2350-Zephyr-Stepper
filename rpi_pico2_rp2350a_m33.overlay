#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2350a-pinctrl.h>

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            pinmux = <SPI0_CSN_P17>, <SPI0_SCK_P18>, <SPI0_TX_P19>;
        };
        group2 {
            pinmux = <SPI0_RX_P16>;
            input-enable;
        };
    };
};

&spi0 {
    status = "okay";
    clock-frequency = <DT_FREQ_M(8)>;
    pinctrl-0 = <&spi0_default>;
    pinctrl-names = "default";
    cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;

    lan9250: lan9250@0 {
        status = "okay";
        /* Project-local fork of Zephyr's upstream "microchip,lan9250"
         * driver (drivers/eth_lan9250/) - see the file header comment
         * there and THEORY_OF_OPERATION.md's "Forked LAN9250 driver"
         * section for why. */
        compatible = "rp2350zs,lan9250";
        reg = <0x0>;
        /* Boot-time-only fallback - src/eth_id.c overrides this at runtime
         * with a MAC derived from the RP2350's real per-chip unique ID
         * (hwinfo), so every board gets its own stable, distinct address
         * instead of this fixed placeholder. */
        local-mac-address = [00 00 00 01 02 03];
        /* Datasheet TABLE 10-3 "SPI/SQI Timing Values": f_sck maxes out at
         * 80MHz for writes/Dual/Quad SIO instructions but only 30MHz for
         * (single-line) Read instructions (Note 3) - and this driver uses
         * single-line reads exclusively (RX FIFO pulls, register polling),
         * so 30MHz is the real ceiling here. Raised from the original
         * 10MHz to 25MHz, leaving some margin below that limit for this
         * hand-wired setup. */
        spi-max-frequency = <25000000>;
        int-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
        /* Now supported by our own rp2350zs,lan9250 binding (the upstream
         * microchip,lan9250 binding this project forked didn't declare
         * this property). Without a real reset pulse here, a warm RP2350
         * reset (e.g. reflashing over USB) doesn't reset the LAN9250
         * itself, letting it retain state from its previous boot -
         * eth_lan9250.c's lan9250_init() already had the correct,
         * datasheet-timed pulse logic for this, it just never ran because
         * this property didn't exist for it to bind to. */
        reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
    };
};

&gpio0 {
    status = "okay";
};

/* Reserve the top 128KB (2x64KB) of SRAM for the bare-metal core1 image at
 * 0x20062000-0x20082000; Zephyr/core0 is confined to the bottom 392KB.
 * CONFIG_SRAM_SIZE/CONFIG_SRAM_BASE_ADDRESS (and thus the linker RAM region
 * and the RP2350 MPU SRAM_0 region) derive directly from this node's reg. */
&sram0 {
    reg = <0x20000000 DT_SIZE_K(392)>;
};

&mbox {
    status = "okay";
};

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
    };
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        status = "okay";
        compatible = "zephyr,cdc-acm-uart";
        label = "Zephyr USB CDC ACM";
    };
};
